<UserControl 
	x:Class="GovTransportApp.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:GovTransportApp.Pages"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	mc:Ignorable="d"
	d:DesignHeight="450"
    d:DesignWidth="800"
	d:Background="White">
	<Grid>
		<Image 
			Source="/Resources/Img/gai.png"
			Width="200"
			Height="200"
			VerticalAlignment="Top"
			HorizontalAlignment="Center"/>

		<Grid 
			VerticalAlignment="Center"
			HorizontalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*"/>
			</Grid.ColumnDefinitions>

			<Button
				x:Name="ButtonMakeOwnership"
				Click="ButtonMakeOwnership_Click"
				Grid.Column="0"
				Height="50"
				Width="230"
				Background="Transparent"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				materialDesign:ButtonAssist.CornerRadius="5"
				Padding="0"
				Margin="0 0 10 0">
				<StackPanel
					Orientation="Horizontal">
					<materialDesign:PackIcon
						Kind="Transportation"
						Foreground="Black"
						Height="35"
						Width="35"
						Margin="5" />
					<TextBlock
						Text="Поставить ТС на учет"
						Margin="10"
						Foreground="Black"
						FontSize="16"
						FontWeight="SemiBold"
						VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<Button
				x:Name="ButtonVinSearch"
				Click="ButtonVinSearch_Click"
				Grid.Column="1"
				Height="50"
				Width="230"
				Background="Transparent"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				materialDesign:ButtonAssist.CornerRadius="5"
				Padding="0"
				Margin="0 0 10 0">
				<StackPanel
					Orientation="Horizontal">
					<materialDesign:PackIcon
						Kind="SearchGlobe"
						Foreground="Black"
						Height="35"
						Width="35"
						Margin="5" />
					<TextBlock
						Text="Поиск ТС по VIN"
						Margin="10"
						Foreground="Black"
						FontSize="16"
						FontWeight="SemiBold"
						VerticalAlignment="Center" />
				</StackPanel>
			</Button>
		</Grid>
	</Grid>
</UserControl>
