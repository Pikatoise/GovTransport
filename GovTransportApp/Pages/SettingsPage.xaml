<UserControl 
    x:Class="GovTransportApp.Pages.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:local="clr-namespace:GovTransportApp.Pages"
	mc:Ignorable="d" 
	d:DesignHeight="450" 
	d:DesignWidth="800"
	d:Background="White"
	Loaded="UserControl_Loaded">
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="0.2*" />
				<RowDefinition
					Height="*"/>
				<RowDefinition
					Height="0.4*" />
			</Grid.RowDefinitions>

			<TextBlock 
				Grid.Row="0"
				Text="Пользователи"
				FontSize="24"
				FontWeight="SemiBold"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"/>

			<DataGrid
				x:Name="DGridUsers"
				Margin="5 0"
				Grid.Row="1"
				AutoGenerateColumns="False"
				HeadersVisibility="Column"
				CanUserAddRows="False"
				CanUserDeleteRows="False"
				CanUserReorderColumns="False"
				CanUserResizeColumns="True"
				CanUserResizeRows="True"
				CanUserSortColumns="True"
				IsReadOnly="True"
				BorderBrush="#3f51b5"
				FontSize="14"
				FontWeight="SemiBold">
				<DataGrid.Background>
					<SolidColorBrush
						Color="LightGray" Opacity="0.2"/>
				</DataGrid.Background>
				<DataGrid.Columns>
					<materialDesign:DataGridTextColumn
						Binding="{Binding Path=Id}" 
						Header="Идентификатор"
						Width="140"/>
					<materialDesign:DataGridTextColumn 
						Binding="{Binding Path=Login}"
						Header="Логин"/>
					<materialDesign:DataGridTextColumn 
						Binding="{Binding Path=AccessLevel}"
						Header="Уровень"/>
				</DataGrid.Columns>
			</DataGrid>

			<Grid
				Grid.Row="2"
				Margin="10 5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button
					x:Name="ButtonAddUser"
					Click="ButtonAddUser_Click"
					Grid.Column="0"
					Height="30"
					Background="ForestGreen"
					BorderThickness="0"
					materialDesign:ButtonAssist.CornerRadius="5"
					Padding="0"
					Margin="10 0 10 0"
					VerticalAlignment="Top">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon
							Kind="UserAdd"
							Foreground="White"
							Height="25"
							Width="25"
							Margin="0 0 5 0"/>
						<TextBlock 
							Text="Добавить" 
							VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Button
					x:Name="ButtonRemoveUser"
					Click="ButtonRemoveUser_Click"
					Grid.Column="1"
					Height="30"
					Background="Red"
					BorderThickness="0"
					materialDesign:ButtonAssist.CornerRadius="5"
					Padding="0"
					Margin="10 0 10 0"
					VerticalAlignment="Top">
					<StackPanel
						Orientation="Horizontal">
						<materialDesign:PackIcon
							Kind="UserRemove"
							Foreground="White"
							Height="25"
							Width="25"
							Margin="0 0 5 0" />
						<TextBlock
							Text="Удалить"
							VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Grid>


		</Grid>

		<Grid
			Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="0.2*" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="0.4*" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Text="Токены"
				FontSize="24"
				FontWeight="SemiBold"
				VerticalAlignment="Center"
				HorizontalAlignment="Center" />

			<DataGrid
				x:Name="DGridTokens"
				Margin="5 0"
				Grid.Row="1"
				AutoGenerateColumns="False"
				HeadersVisibility="Column"
				CanUserAddRows="False"
				CanUserDeleteRows="False"
				CanUserReorderColumns="False"
				CanUserResizeColumns="True"
				CanUserResizeRows="True"
				CanUserSortColumns="True"
				IsReadOnly="True"
				BorderBrush="#3f51b5"
				FontSize="14"
				FontWeight="SemiBold">
				<DataGrid.Background>
					<SolidColorBrush
						Color="LightGray"
						Opacity="0.2" />
				</DataGrid.Background>
				<DataGrid.Columns>
					<materialDesign:DataGridTextColumn
						Binding="{Binding Path=TokenValue}"
						Header="Токен"
						Width="85"/>
					<materialDesign:DataGridTextColumn
						Binding="{Binding Path=Description}"
						Header="Описание" />
					<materialDesign:DataGridTextColumn 
						Binding="{Binding Path=End}"
						Header="Окончание"/>
					<materialDesign:DataGridTextColumn
						Binding="{Binding Path=AccessLevel}"
						Header="Уровень" />
				</DataGrid.Columns>
			</DataGrid>

			<Grid
				Grid.Row="2"
				Margin="10 5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button
					x:Name="ButtonAddToken"
					Click="ButtonAddToken_Click"
					Grid.Column="0"
					Height="30"
					Background="ForestGreen"
					BorderThickness="0"
					materialDesign:ButtonAssist.CornerRadius="5"
					Padding="0"
					Margin="10 0 10 0"
					VerticalAlignment="Top">
					<StackPanel
						Orientation="Horizontal">
						<materialDesign:PackIcon
							Kind="KeyAdd"
							Foreground="White"
							Height="25"
							Width="25"
							Margin="0 0 5 0" />
						<TextBlock
							Text="Сгенерировать"
							VerticalAlignment="Center" />
					</StackPanel>
				</Button>

				<Button
					x:Name="ButtonRemoveToken"
					Click="ButtonRemoveToken_Click"
					Grid.Column="1"
					Height="30"
					Background="Red"
					BorderThickness="0"
					materialDesign:ButtonAssist.CornerRadius="5"
					Padding="0"
					Margin="10 0 10 0"
					VerticalAlignment="Top">
					<StackPanel
						Orientation="Horizontal">
						<materialDesign:PackIcon
							Kind="KeyRemove"
							Foreground="White"
							Height="25"
							Width="25"
							Margin="0 0 5 0" />
						<TextBlock
							Text="Удалить"
							VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Grid>
		</Grid>

	</Grid>
</UserControl>
