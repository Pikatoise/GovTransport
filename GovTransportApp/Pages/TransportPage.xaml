<UserControl 
    x:Class="GovTransportApp.Pages.TransportPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:local="clr-namespace:GovTransportApp.Pages"
	mc:Ignorable="d"
	d:DesignHeight="450"
	d:DesignWidth="800"
	d:Background="White"
	Loaded="UserControl_Loaded">
	<Grid
		Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="0.3*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>

		<Grid
			Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="0.1*" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="0.1*" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="0.25*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>

				<materialDesign:PackIcon
					Grid.Column="0"
					Kind="Search"
					Foreground="Black"
					Width="25"
					Height="25"
					VerticalAlignment="Center"
					HorizontalAlignment="Center" />

				<TextBox
					x:Name="TBoxGovNumberSearch"
					TextChanged="TBoxGovNumberSearch_TextChanged"
					Grid.Column="1"
					Height="35"
					Padding="10 0"
					FontSize="16"
					Margin="0 0 20 0"
					HorizontalAlignment="Stretch"
					materialDesign:HintAssist.Hint="Номер" />
			</Grid>

			<Border
				BorderBrush="#3f51b5"
				BorderThickness="2"
				CornerRadius="10"
				Grid.Row="1">
				<Grid>
					<ListBox
						x:Name="LBoxTransports"
						SelectionChanged="LBoxTransports_SelectionChanged" />
					<TextBlock
						x:Name="TBlockEmptyTransports"
						Text="Пусто..."
						FontSize="16"
						Visibility="Collapsed"
						FontWeight="Bold"
						HorizontalAlignment="Center"
						Margin="0 20 0 0" />
				</Grid>
			</Border>

			<Button
				x:Name="ButtonAddTransport"
				Click="ButtonAddTransport_Click"
				Grid.Row="2"
				Background="ForestGreen"
				BorderThickness="0"
				materialDesign:ButtonAssist.CornerRadius="5"
				Padding="0"
				Margin="0"
				VerticalAlignment="Bottom">
				<StackPanel
					Orientation="Horizontal">
					<TextBlock
						Text="Добавить"
						VerticalAlignment="Center" />
				</StackPanel>
			</Button>
		</Grid>
		
		<Grid
			x:Name="GridTransportInfo"
			Grid.Column="1"
			Visibility="Hidden"
			d:Visibility="Visible">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="0.4*" />
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="0.5*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
					<RowDefinition
						Height="0.4*" />
				</Grid.RowDefinitions>

				<Border
					BorderThickness="0 0 2 0"
					BorderBrush="#3f51b5"
					Grid.RowSpan="8"
					Margin="0 0 6 0" />

				<Grid
					Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="0.3*" />
					</Grid.ColumnDefinitions>

					<TextBlock
						x:Name="TBlockTransportGovNumber"
						Grid.Column="0"
						FontSize="24"
						VerticalAlignment="Center"
						Margin="10 0 20 0"
						FontWeight="SemiBold"
						d:Text="О111ОО56"
						TextWrapping="Wrap" />

					<Button
						x:Name="ButtonEditTransport"
						Click="ButtonEditTransport_Click"
						Grid.Column="1"
						Padding="0"
						FontSize="10"
						Foreground="Black"
						Margin="10 0 20 0"
						Height="30"
						Background="Transparent"
						BorderBrush="#3f51b5">
						<materialDesign:PackIcon
							Kind="Edit" />
					</Button>
				</Grid>

				<StackPanel
					Grid.Row="1">
					<TextBlock
						Text="VIN:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockVin"
						d:Text="4DRBWAFN06A207518"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>

				<StackPanel
					Grid.Row="2">
					<TextBlock
						Text="Модель:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockModel"
						d:Text="Toyota Camry"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>

				<StackPanel
					Grid.Row="3">
					<TextBlock
						Text="Кузов:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockBodyType"
						d:Text="Sedan"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>

				<StackPanel
					Grid.Row="4">
					<TextBlock
						Text="Цвет:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockColor"
						d:Text="Белый"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>

				<StackPanel
					Grid.Row="5">
					<TextBlock
						Text="Год выпуска:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockReleaseYear"
						d:Text="2000"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>

				<StackPanel
					Grid.Row="6">
					<TextBlock
						Text="Статус:"
						FontSize="24"
						FontWeight="SemiBold"
						Margin="10 5 0 0" />

					<TextBlock
						x:Name="TBlockStatus"
						d:Text="Ok"
						FontSize="20"
						Margin="10 5 0 0" />
				</StackPanel>
			</Grid>

			<Grid
				Grid.Column="1"
				Margin="0 10">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="0.1*" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Text="Последний владелец"
					TextWrapping="Wrap"
					FontWeight="SemiBold"
					FontSize="16"
					TextAlignment="Center" />

				<StackPanel 
					x:Name="SPanelTransportOwnerInfo"
					Grid.Row="1">
					<StackPanel>
						<TextBlock
							Text="ФИО:"
							FontSize="14"
							FontWeight="SemiBold"
							Margin="10 5 0 0" />

						<TextBlock
							x:Name="TBlockTransportOwnerFullName"
							d:Text="Иванов Иван Иванович"
							TextWrapping="Wrap"
							FontSize="12"
							Margin="10 5 0 0" />
					</StackPanel>

					<StackPanel>
						<TextBlock
							Text="Паспорт:"
							FontSize="14"
							FontWeight="SemiBold"
							Margin="10 5 0 0" />

						<TextBlock
							x:Name="TBlockTransportOwnerPassport"
							d:Text="8291 962757"
							TextWrapping="Wrap"
							FontSize="12"
							Margin="10 5 0 0" />
					</StackPanel>

					<StackPanel>
						<TextBlock
							Text="Дата владения:"
							FontSize="14"
							FontWeight="SemiBold"
							Margin="10 5 0 0" />

						<TextBlock
							x:Name="TBlockTransportOwnerOwnDate"
							d:Text="2020.2.20 > 2022.4.24"
							TextWrapping="Wrap"
							FontSize="12"
							Margin="10 5 0 0" />
					</StackPanel>
				</StackPanel>

				<TextBlock
					x:Name="TBlockTransportOwnerEmpty"
					Grid.Row="1"
					Text="Отсутствует..."
					FontSize="16"
					Margin="0 20 0 0"
					HorizontalAlignment="Center"
					Visibility="Hidden" />
			</Grid>
		</Grid>
		
	</Grid>
</UserControl>
