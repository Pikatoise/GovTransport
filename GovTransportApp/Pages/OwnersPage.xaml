<UserControl 
	x:Class="GovTransportApp.Pages.OwnersPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:local="clr-namespace:GovTransportApp.Pages"
	mc:Ignorable="d" 
	d:DesignHeight="450" 
	d:DesignWidth="800"
	d:Background="White"
	Loaded="UserControl_Loaded">
	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="0.3*" />
			<ColumnDefinition
				Width="*"/>
		</Grid.ColumnDefinitions>

		<Grid
			Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition 
					Height="0.1*"/>
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="0.25*" />
					<ColumnDefinition
						Width="*"/>
				</Grid.ColumnDefinitions>

				<materialDesign:PackIcon
					Grid.Column="0"
					Kind="Search"
					Foreground="Black"
					Width="25"
					Height="25"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"/>

				<TextBox
					x:Name="TBoxPassportSearch"
					TextChanged="TBoxPassportSearch_TextChanged"
					Grid.Column="1"
					Height="35"
					Padding="10 0"
					FontSize="16"
					Margin="0 0 20 0"
					HorizontalAlignment="Stretch"
					materialDesign:HintAssist.Hint="Паспорт" />
			</Grid>

			<Border
				BorderBrush="#3f51b5"
				BorderThickness="2"
				CornerRadius="10"
				Grid.Row="1">
				<Grid>
					<ListBox
						x:Name="LBoxOwners"
						SelectionChanged="LBoxOwners_SelectionChanged"/>
				<TextBlock 
					x:Name="TBlockEmptyOwners"
					Text="Пусто..."
					FontSize="16"
					Visibility="Collapsed"
					FontWeight="Bold"
					HorizontalAlignment="Center"
					Margin="0 20 0 0"/>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
