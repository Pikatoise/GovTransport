<Window x:Class="GovTransportApp.Dialogs.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GovTransportApp.Dialogs"
	    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	    mc:Ignorable="d"
	    Title="Пользователь" 
        Height="350" 
        Width="300"
	    WindowStartupLocation="CenterScreen"
	    WindowStyle="SingleBorderWindow"
	    ResizeMode="CanMinimize"
	    Background="#f4f6f9">
	<Grid Margin="20">
		<StackPanel>
			<TextBox
				x:Name="TBoxLogin"
				Height="45"
				Margin="0 0 0 10"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				FontSize="16"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Логин" />

			<PasswordBox
				x:Name="TBoxPassword"
				Height="45"
				Margin="0 0 0 10"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				FontSize="16"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Пароль" />
		</StackPanel>

		<Button
				Content="Добавить"
				Click="Button_Click"
				FontSize="16"
				Height="45"
				HorizontalAlignment="Stretch"
				Background="#3f51b5"
				Foreground="White"
				FontWeight="SemiBold"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				materialDesign:ButtonAssist.CornerRadius="5"
				VerticalAlignment="Bottom"/>
	</Grid>
</Window>
