<Window 
    x:Class="GovTransportApp.Dialogs.UchetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:GovTransportApp.Dialogs"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	mc:Ignorable="d"
	Title="Постановка на учет"
	Height="400"
	Width="600"
	WindowStartupLocation="CenterScreen"
	WindowStyle="SingleBorderWindow"
	ResizeMode="CanMinimize"
	Background="#f4f6f9">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition 
				Height="*"/>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="0.5*" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Grid.RowSpan="3"
			Background="#f4f6f9">
			<Image
				Source="/Resources/Img/bg.png"
				Stretch="UniformToFill"
				Opacity="0.5" />
		</Border>

		<Border
			Grid.Row="0"
			BorderBrush="#3f51b5"
			BorderThickness="0 0 0 2"
			Margin="6 0 7 0">
			<Grid x:Name="GridOwner">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>

				<StackPanel 
					Orientation="Horizontal"
					Grid.Row="0"
					VerticalAlignment="Center"
					HorizontalAlignment="Center">
					<TextBlock 
						Text="Владелец"
						FontSize="32"
						VerticalAlignment="Center"
						FontWeight="SemiBold"/>

					<materialDesign:PackIcon 
						x:Name="IconOwner"
						VerticalAlignment="Bottom"
						Kind="CrossCircleOutline"
						d:Kind="CheckboxMarkedCircleOutline"
						Width="40"
						Height="40"
						Foreground="Red"
						Margin="20 0 0 0"/>
				</StackPanel>

				<StackPanel
					Orientation="Horizontal"
					Grid.Row="1"
					VerticalAlignment="Center"
					HorizontalAlignment="Center">
					<Button 
						x:Name="ButtonAddOwner"
						Click="ButtonAddOwner_Click"
						Content="Добавить"
						Background="#3f51b5"
						Margin="0 0 10 0"/>

					<Button
						x:Name="ButtonSelectOwner"
						Click="ButtonSelectOwner_Click"
						Content="Выбрать"
						Background="#3f51b5" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid
			x:Name="GridTransport"
			Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>

			<StackPanel
				Orientation="Horizontal"
				Grid.Row="0"
				VerticalAlignment="Center"
				HorizontalAlignment="Center">
				<TextBlock
					Text="Транспорт"
					FontSize="32"
					VerticalAlignment="Center"
					FontWeight="SemiBold" />

				<materialDesign:PackIcon
					x:Name="IconTransport"
					VerticalAlignment="Bottom"
					Kind="CrossCircleOutline"
					d:Kind="CheckboxMarkedCircleOutline"
					Width="40"
					Height="40"
					Foreground="Red"
					Margin="20 0 0 0" />
			</StackPanel>

			<StackPanel
				Orientation="Horizontal"
				Grid.Row="1"
				VerticalAlignment="Center"
				HorizontalAlignment="Center">
				<Button
					x:Name="ButtonAddTransport"
					Click="ButtonAddTransport_Click"
					Content="Добавить"
					Background="#3f51b5"
					Margin="0 0 10 0" />

				<Button
					x:Name="ButtonSelectTransport"
					Click="ButtonSelectTransport_Click"
					Content="Выбрать"
					Background="#3f51b5" />
			</StackPanel>
		</Grid>

		<Button
			x:Name="ButtonSaveUchet"
			Click="ButtonSaveUchet_Click"
			Grid.Row="2"
			Width="200"
			Height="40"
			Background="#3f51b5"
			Padding="0">
			<StackPanel
				Orientation="Horizontal">
				<materialDesign:PackIcon 
					Kind="FileDocument"
					Margin="0 0 10 0"
					Height="25"
					Width="25"
					VerticalAlignment="Center"/>
				<TextBlock 
					Text="Поставить на учет"
					FontSize="16"
					FontWeight="SemiBold"
					VerticalAlignment="Center"/>
			</StackPanel>
		</Button>
	</Grid>
</Window>
