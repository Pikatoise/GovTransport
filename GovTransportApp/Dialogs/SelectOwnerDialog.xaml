<Window 
    x:Class="GovTransportApp.Dialogs.SelectOwnerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:GovTransportApp.Dialogs"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    Title="Выбор владельца"
    Height="400"
    Width="250"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanMinimize"
    Background="#f4f6f9"
	Loaded="Window_Loaded">
    <Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0.1*" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="0.15*" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
            Grid.Column="0"
			Grid.RowSpan="3"
			Grid.ColumnSpan="3"
			Background="#f4f6f9">
			<Image
				Source="/Resources/Img/bg.png"
				Stretch="UniformToFill"
				Opacity="0.5" />
		</Border>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="0.25*" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>

			<materialDesign:PackIcon
				Grid.Column="0"
				Kind="Search"
				Foreground="Black"
				Width="25"
				Height="25"
				VerticalAlignment="Center"
				HorizontalAlignment="Center" />

			<TextBox
				x:Name="TBoxPassportSearch"
				TextChanged="TBoxPassportSearch_TextChanged"
				Grid.Column="1"
				Height="35"
				Padding="10 0"
				FontSize="16"
				Margin="0 0 20 0"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Паспорт" />
		</Grid>

		<Border
			BorderBrush="#3f51b5"
			BorderThickness="2"
			CornerRadius="10"
			Grid.Row="1"
			Margin="0 10 0 0">
			<Grid>
				<ListBox
					x:Name="LBoxOwners" />
				<TextBlock
					x:Name="TBlockEmptyOwners"
					Text="Пусто..."
					FontSize="16"
					Visibility="Collapsed"
					FontWeight="Bold"
					HorizontalAlignment="Center"
					Margin="0 20 0 0" />
			</Grid>
		</Border>

		<Button
			x:Name="ButtonSelectOwner"
			Click="ButtonSelectOwner_Click"
			Grid.Row="2"
			Background="#3f51b5"
			BorderThickness="0"
			materialDesign:ButtonAssist.CornerRadius="5"
			Padding="0"
			Margin="0"
			VerticalAlignment="Bottom">
			<StackPanel
				Orientation="Horizontal">
				<TextBlock
					Text="Выбрать"
					VerticalAlignment="Center" />
			</StackPanel>
		</Button>
	</Grid>
</Window>
