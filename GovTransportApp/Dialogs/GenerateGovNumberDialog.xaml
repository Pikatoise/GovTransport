<Window 
    x:Class="GovTransportApp.Dialogs.GenerateGovNumberDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:GovTransportApp.Dialogs"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	mc:Ignorable="d"
	Title="Номер"
	Height="250"
	Width="300"
	WindowStartupLocation="CenterScreen"
	WindowStyle="SingleBorderWindow"
	ResizeMode="CanMinimize"
	Background="#f4f6f9">
	<Grid
		Margin="20">
		<Grid
			VerticalAlignment="Top">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>

			<TextBox
				x:Name="TBoxGeneratedGovNumber"
				Grid.Row="0"
				Height="35"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				FontSize="12"
				IsReadOnly="True"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Сгенерируйте номер..."
				Margin="0 0 0 10"/>

			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="0.45*" />
					<ColumnDefinition
						Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBox
					x:Name="TBoxRegion"
					Grid.Column="0"
					Height="35"
					Padding="10 0"
					BorderBrush="#3f51b5"
					BorderThickness="2"
					FontSize="12"
					materialDesign:HintAssist.Hint="Регион" />

				<Button
					x:Name="ButtonGenerateGovNumber"
					Click="ButtonGenerateGovNumber_Click"
					Grid.Column="1"
					Content="Сгенерировать"
					FontSize="16"
					Height="35"
					Padding="0"
					Margin="10 0 0 0"
					Background="#3f51b5"
					Foreground="White"
					FontWeight="SemiBold"
					BorderBrush="#3f51b5"
					BorderThickness="2"
					materialDesign:ButtonAssist.CornerRadius="5"
					VerticalAlignment="Bottom" />
			</Grid>
		</Grid>


		<Button
			Click="Button_Click"
			Content="Ок"
			FontSize="16"
			Height="35"
			Width="45"
			Padding="0"
			HorizontalAlignment="Stretch"
			Background="#3f51b5"
			Foreground="White"
			FontWeight="SemiBold"
			BorderBrush="#3f51b5"
			BorderThickness="2"
			materialDesign:ButtonAssist.CornerRadius="5"
			VerticalAlignment="Bottom" />
	</Grid>
</Window>
