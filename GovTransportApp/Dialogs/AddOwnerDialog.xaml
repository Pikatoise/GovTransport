<Window x:Class="GovTransportApp.Dialogs.AddOwnerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GovTransportApp.Dialogs"
		xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
		mc:Ignorable="d"
		Title="Владелец"
		Height="550"
		Width="400"
		WindowStartupLocation="CenterScreen"
		WindowStyle="SingleBorderWindow"
		ResizeMode="CanMinimize"
		Background="#f4f6f9"
		Loaded="Window_Loaded">
	<Grid
		Margin="20">
		<StackPanel>
			<StackPanel 
				Orientation="Horizontal"
				Margin="0 0 0 10">
				<TextBox
					x:Name="TBoxPassport"
					TextChanged="TBoxPassport_TextChanged"
					Height="45"
					Width="200"
					Padding="10 0"
					BorderBrush="#3f51b5"
					BorderThickness="2"
					FontSize="16"
					HorizontalAlignment="Stretch"
					materialDesign:HintAssist.Hint="Паспорт" />

				<Button
					x:Name="ButtonCheckPassport"
					Content="Проверить"
					Click="ButtonCheckPassport_Click"
					FontSize="14"
					Height="40"
					Background="Transparent"
					Foreground="Black"
					FontWeight="SemiBold"
					BorderBrush="#3f51b5"
					BorderThickness="2"
					Margin="10 0 0 0"
					materialDesign:ButtonAssist.CornerRadius="5"
					VerticalAlignment="Center" />
			</StackPanel>

			<TextBox
				x:Name="TBoxFullName"
				Height="45"
				Margin="0 0 0 10"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				FontSize="16"
				IsEnabled="False"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="ФИО" />

			<TextBox
				x:Name="TBoxRegistration"
				Height="45"
				Margin="0 0 0 10"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				IsEnabled="False"
				FontSize="16"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Адрес регистрации" />

			<TextBox
				x:Name="TBoxOsago"
				Height="45"
				Margin="0 0 0 10"
				Padding="10 0"
				BorderBrush="#3f51b5"
				BorderThickness="2"
				IsEnabled="False"
				FontSize="16"
				HorizontalAlignment="Stretch"
				materialDesign:HintAssist.Hint="Осаго (При наличии)" />

			<CheckBox 
				x:Name="CBoxIsLegal"
				Height="45"
				Content="Юр. лицо?"
				Padding="10 0 0 0"
				IsEnabled="False"/>
		</StackPanel>

		<Button
			x:Name="ButtonSave"
			Content="Добавить"
			Click="Button_Click"
			FontSize="16"
			Height="45"
			HorizontalAlignment="Stretch"
			Background="#3f51b5"
			Foreground="White"
			FontWeight="SemiBold"
			BorderBrush="#3f51b5"
			BorderThickness="2"
			materialDesign:ButtonAssist.CornerRadius="5"
			VerticalAlignment="Bottom" />
	</Grid>
</Window>
