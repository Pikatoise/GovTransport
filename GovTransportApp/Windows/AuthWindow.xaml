<Window
	x:Class="GovTransportApp.Windows.AuthWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:GovTransportApp.Windows"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	mc:Ignorable="d"
	Title="ГАИ"
	Height="600"
	Width="950"
	WindowStartupLocation="CenterScreen"
	WindowStyle="SingleBorderWindow"
	ResizeMode="CanMinimize"
	ShowInTaskbar="True"
	Background="#f4f6f9">

	<Grid>
		<Grid
			Background="WhiteSmoke">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<Border
				Background="#3f51b5"
				Grid.Row="0"
				VerticalAlignment="Center">
				<TextBlock
					FontSize="40"
					FontWeight="Bold"
					Foreground="White"
					Text="Учет ТС ГАИ"
					VerticalAlignment="Center"
					HorizontalAlignment="Center" />
			</Border>

			<Border
				Grid.Row="1"
				Grid.RowSpan="2"
				Background="White"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Margin="20"
				CornerRadius="15"
				BorderBrush="#3f51b5"
				BorderThickness="2">
				<StackPanel
					Width="350"
					Margin="40">
					<TextBlock
						Text="Вход в систему"
						FontSize="28"
						FontWeight="Bold"
						HorizontalAlignment="Center"
						Margin="0 0 0 20" />

					<TextBox
						x:Name="TBoxLogin"
						Width="250"
						Height="45"
						Margin="0 0 0 20"
						Padding="10 0"
						BorderBrush="#3f51b5"
						BorderThickness="2"
						FontSize="16"
						VerticalContentAlignment="Center"
						HorizontalAlignment="Stretch"
						materialDesign:HintAssist.Hint="Логин"/>

					<PasswordBox
						x:Name="PBoxPassword"
						Width="250"
						Height="45"
						Margin="0 0 0 20"
						Padding="10 0"
						BorderBrush="#3f51b5"
						BorderThickness="2"
						FontSize="16"
						VerticalContentAlignment="Center"
						HorizontalAlignment="Stretch"
						materialDesign:HintAssist.Hint="Пароль"/>

					<TextBlock
						x:Name="ErrorText"
						Foreground="Red"
						FontSize="12"
						Visibility="Collapsed"
						HorizontalAlignment="Center"
						Text="Неверный логин или пароль" />

					<Button
						Content="Войти"
						FontSize="16"
						Height="45"
						Click="Button_Click"
						HorizontalAlignment="Stretch"
						Background="#3f51b5"
						Foreground="White"
						FontWeight="SemiBold"
						BorderBrush="#3f51b5"
						BorderThickness="2"
						materialDesign:ButtonAssist.CornerRadius="5" />
				</StackPanel>
			</Border>

			<TextBlock
				Grid.Row="3"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Margin="0,10"
				FontSize="12"
				Foreground="Gray"
				Text="© 2025 ГАИ. Все права защищены." />
		</Grid>
	</Grid>
</Window>
